rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    match /users/{userId} {
      allow read, write: if request.auth != null && request.auth.uid == userId;

      match /clients/{clientId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /projets/{projetId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Événements créés par le Studio (tournages, relances, deadlines) —
      // matérialisés depuis les projets et poussés vers Google Calendar. Le
      // refreshToken Google ne vit PAS ici : il reste dans un doc serveur-only
      // écrit par les functions via le compte de service (jamais côté client).
      match /calendarEvents/{eventId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /idees/{ideeId} {
        // Le propriétaire connecté peut lire, supprimer ET générer à la demande
        // ses propres études/idées depuis l'app ("Générer maintenant" /
        // "Analyse concurrentielle"). La tâche hebdomadaire serverless
        // (/api/ideas-ingest.js, compte de service Google) écrit aussi en
        // parallèle via l'API REST OAuth2.
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      // Tout le reste (settings, devisListe, factures, transactions, catalogue,
      // contrats, autorisations, musiques, etc.) reste sous la règle générique
      // propriétaire ci-dessus, mais explicite plutôt que via un wildcard
      // récursif fourre-tout. Un match sur le document /users/{userId} seul ne
      // couvre PAS ses sous-collections en Firestore — chacune doit être listée.
      match /data/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /catalogue/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /contrats/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /autorisations/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
      match /musiques/{docId} {
        allow read, write: if request.auth != null && request.auth.uid == userId;
      }
    }

    // Collections utilisées uniquement par les fonctions serverless du CRM
    // (liens de signature, mapping d'abonnements Stripe), authentifiées via
    // un compte de service Google (IAM) qui contourne ces règles. Aucun client
    // (navigateur, app) ne doit jamais y accéder directement.
    match /signatureRequests/{token} {
      allow read, write: if false;
    }
    match /stripeSubscriptions/{subId} {
      allow read, write: if false;
    }
    // OAuth Google Calendar (T3) : refresh token + mapping state→uid. Écrits
    // UNIQUEMENT par les functions serverless via le compte de service (qui
    // contourne ces règles). Le navigateur ne doit jamais y accéder — le
    // refresh token ne quitte jamais le serveur.
    match /googleAuth/{uid} {
      allow read, write: if false;
    }
    match /googleAuthState/{state} {
      allow read, write: if false;
    }
  }
}
