{
  "rewrites": [
    {
      "source": "/api/google/:action",
      "destination": "/api/google?action=:action"
    },
    {
      "source": "/api/submit-signature",
      "destination": "/api/sign"
    },
    {
      "source": "/api/calendar/:action",
      "destination": "/api/calendar?action=:action"
    },
    {
      "source": "/api/(.*)",
      "destination": "/api/$1"
    },
    {
      "source": "/(.*)",
      "destination": "/index.html"
    }
  ],
  "functions": {
    "api/claude.js": {
      "memory": 256,
      "maxDuration": 300
    },
    "api/project-share.js": {
      "memory": 256
    },
    "api/project-validate.js": {
      "memory": 256
    },
    "api/signature.js": {
      "memory": 256
    },
    "api/sign.js": {
      "memory": 256
    },
    "api/send-email.js": {
      "memory": 256
    },
    "api/abby.js": {
      "memory": 256
    }
  }
}